# Backend: "ollama" (native API, base URL without /v1) or "openai" (any OpenAI-compatible API, base URL with /v1)
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=ollama
GENERATOR_MODEL=qwen3:4b
CLASSIFIER_MODEL=qwen3:4b
# Eval-only judge. Empty = heuristic judging. Should be a different model family than the generator.
JUDGE_MODEL=
# Prompt Guard 2 needs: pip install -e '.[promptguard]', accepting the licence on Hugging Face, and HF_TOKEN.
ENABLE_PROMPT_GUARD=false
PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-22M
HF_TOKEN=
DB_PATH=data/guardrail.db
POLICY_PATH=config/policy.yaml
PRICES_PATH=config/prices.yaml
MAX_REPAIR_ATTEMPTS=2
LLM_TIMEOUT_S=180
API_URL=http://localhost:8000
